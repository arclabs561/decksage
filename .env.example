# DeckSage Development Environment
# Copy to .env and fill in values

# ── Core ──────────────────────────────────────────────────
DECKSAGE_GAMES=magic,pokemon,yugioh
DECKSAGE_DEFAULT_GAME=magic
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Embeddings (per-game, v7 fused) ──────────────────────
EMBEDDINGS_PATH_MAGIC=./data/embeddings/magic_v7_spectral_mu35.wv
EMBEDDINGS_PATH_POKEMON=./data/embeddings/pokemon_v7_fused.wv
EMBEDDINGS_PATH_YUGIOH=./data/embeddings/yugioh_v7_spectral_mu3.wv

# ── Co-occurrence graphs (per-game) ──────────────────────
PAIRS_PATH_MAGIC=./data/processed/pairs_large.csv
PAIRS_PATH_POKEMON=./data/processed/pairs_pokemon_limitless_expanded.csv
PAIRS_PATH_YUGIOH=./data/processed/pairs_yugioh_masterduelmeta.csv

# ── Card attributes (optional) ───────────────────────────
# ATTRIBUTES_PATH_MAGIC=./data/processed/card_attributes_enriched.csv

# ── Embedding models ─────────────────────────────────────
INSTRUCTION_EMBEDDER_MODEL=intfloat/e5-base-v2
VISUAL_EMBEDDER_MODEL=google/siglip-base-patch16-224

# ── Search backends (docker compose up) ──────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=
QDRANT_URL=http://localhost:6333

# ── LLM / Annotation ────────────────────────────────────
LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# GROQ_API_KEY=gsk_...
# CEREBRAS_API_KEY=csk-...
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=detailed

# ── Caching ──────────────────────────────────────────────
LLM_CACHE_DIR=.cache/llm_responses
LLM_CACHE_TTL_SECONDS=2592000
